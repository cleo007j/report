#include <stdio.h>
 
int main(void)
{
    // 초기설명: n: 출력할 모래시계의 전체 높이자 가장 긴 줄의 별 개수입니다.
    // scanf_s는 Visual Studio 환경에서 안전하게 정수를 입력받기 위한 함수입니다.
    // 만약 5를 넣고 시작해 봅시
    int n;
 
    printf("Enter an odd number: ");
    scanf_s("%d", &n);
 
    // 상단부
    // 줄 수 계산: 정수 나눗셈에 의해 $5 / 2 + 1 = 3$이 되므로, i는 0, 1, 2 순서로 총 3줄을 실행합니다.
    for (int i = 0; i < n / 2 + 1; i++)
    {
        // 공백 출력 줄 번호 i의 값만큼 공백을 출력합니다.
        // i = 0: 공백 0개 i = 1: 공백 1개 i = 2: 공백 2개
        for (int j = 0; j < i; j++)
        {
            printf(" ");
        }
 
        // 별 출력 각 줄마다 n - 2 * i 공식에 따라 별을 출력합니다.
        // i = 0: 5 - 0 = 5개 (*****), i = 0: 5 - 2 = 3개 (***) i = 0: 5 - 4 = 1개 (*)
        for (int j = 0; j < n - 2 * i; j++)
        {
            printf("*");
        }
 
        printf("\n");
    }
 
    // 하단부
    // 역순 제어: n / 2 - 1은 5 / 2 - 1 = 1이므로, i가 1에서 시작해 0까지 1씩 감소하면서 2줄을 실행합니다.
    // 상단부에서 사용했던 공백과 별 출력 공식을 그대로 재사용하되, i의 값을 역순으로 줄여나가면서 모양을 다시 넓힙니다.
    for (int i = n / 2 - 1; i >= 0; i--)
    {
        // 공백 출력 줄 번호 i의 값만큼 공백을 출력합니다. i가 줄어들기 때문에 줄이 내려갈수록 공백의 개수도 줄어듭니다.
        for (int j = 0; j < i; j++)
        {
            printf(" ");
        }
 
        // 별 출력 각 줄마다 n - 2 * i 공식에 따라 별을 출력합니다. i가 줄어들수록 뺄셈 값이 작아져 별의 개수가 다시 늘어납니다.
        for (int j = 0; j < n - 2 * i; j++)
        {
            printf("*");
        }
 
        printf("\n");
    }
 
    return 0;
} 
   
